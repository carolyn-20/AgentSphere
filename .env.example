NODE_ENV=development
DATABASE_URL=postgresql://agentsphere:agentsphere_dev@postgres:5432/agentsphere
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ENCRYPTION_KEY=replace-with-a-generated-32-byte-key
API_PORT=4000
PROCESSOR_URL=http://processor:8000
NEXT_PUBLIC_API_URL=http://localhost:4000
SEED_EMAIL=owner@example.test
SEED_PASSWORD=replace-with-a-strong-password
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_AGENT_STEPS=8
MAX_EXECUTION_SECONDS=60
DEFAULT_MONTHLY_TOKEN_LIMIT=100000
UPLOAD_MAX_MB=10
